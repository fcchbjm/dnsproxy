# This is the yaml configuration file for dnsproxy with minimal working
# configuration, all the options available can be seen with ./dnsproxy --help.
# To use it within dnsproxy specify the --config-path=/<path-to-config.yaml>
# option.  Any other command-line options specified will override the values
# from the config file.
---
bootstrap:
  - "8.8.8.8:53"
# DNSSEC validation is enabled by default, if you want to disable it set it to
# false.
dnssec: true
listen-addrs:
  - "0.0.0.0"
listen-ports:
  - 53
# Require Proxy Protocol v2 headers for plain DNS-over-TCP listeners.
tcp-proxy-protocol-v2: false
# Require Proxy Protocol v2 headers for DNS-over-TLS listeners.
tls-proxy-protocol-v2: false
# Timeout for reading Proxy Protocol v2 preface/payload on new TCP/TLS connections.
proxy-protocol-v2-read-timeout: '3s'
# DoT handshake and idle read timeout. Standalone default is 60s (library zero
# still means 600s for embedders). Shorten further under overload risk.
tls-timeout: '60s'
# Trusted proxy CIDRs for DoH client-IP headers and Proxy Protocol v2.
# Default is empty (trust nobody). Behind an LB, list the LB/proxy CIDRs, e.g.:
# trusted-proxies:
#   - "10.0.0.0/8"
#   - "192.168.0.0/16"
trusted-proxies: []
# Recommended default for PPv2 deployments; tune by host capacity.
max-go-routines: 32
# Optional hard cap on concurrent accepted TCP/DoT connections (0 = unlimited).
# Orthogonal to max-go-routines. Public deployments: strongly consider setting
# an explicit value (e.g. 512).
# max-tcp-connections: 512
# Optional hard cap on in-flight DoH requests via ServeHTTP (0 = unlimited).
# Orthogonal to max-go-routines / max-tcp-connections. Public: e.g. 256.
# doh-max-concurrent: 256
# Minimum TLS version for DoT/DoH listeners when TLS certs are configured.
# Default when unset: 1.2. Set explicitly to lower if required (e.g. 1.0).
# tls-min-version: 1.2
ratelimit: 0
ratelimit-subnet-len-ipv4: 24
ratelimit-subnet-len-ipv6: 64
udp-buf-size: 0
upstream:
  - "1.1.1.1:53"
timeout: '10s'
